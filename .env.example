# Copie este arquivo para ".env" em desenvolvimento local.
# Em produção (Render), configure estas mesmas chaves em
# Dashboard do serviço > Environment > Environment Variables.

ENV=development

# String de conexão do MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=instituto_oliveira

# Gere uma chave forte, por exemplo com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-esta-chave-por-uma-aleatoria-e-longa
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=720

# Domínios que podem chamar a API (frontend no Vercel + domínio final no Squarespace DNS)
CORS_ORIGINS=https://www.institutooliveira.com,https://institutooliveira.com,http://localhost:5500

# Cloudinary (cloudinary.com — plano gratuito) usado para hospedar as imagens
# enviadas pelo painel administrativo (fotos de ações, capa das publicações)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Usados apenas pelo script "python -m app.utils.seed" para criar o 1º admin
ADMIN_SEED_NOME=Francisca Oliveira Lopes
ADMIN_SEED_EMAIL=institutooliveira7@gmail.com
ADMIN_SEED_SENHA=TrocarEssaSenha123!
